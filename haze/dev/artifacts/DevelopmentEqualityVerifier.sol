pragma solidity ^0.8.28;

/// @notice Development rehearsal verifier. NOT FOR PRODUCTION.
/// @dev Generated by haze/dev/ceremony. T2.1 wraps this as a development backend.
contract DevelopmentEqualityVerifier {
    bool public constant NOT_FOR_PRODUCTION = true;
    bytes32 public constant ARTIFACT_HASH = 0x16824b61154c52717ba74edc9335e92f053317835c39bdcaa5290a484e5ca039;

    function verify(uint256 privateValue, uint256 publicValue, bytes32 artifactHash) external pure returns (bool) {
        require(artifactHash == ARTIFACT_HASH, "ARTIFACT");
        return privateValue == publicValue;
    }
}
