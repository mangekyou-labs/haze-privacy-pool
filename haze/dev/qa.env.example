# Disposable QA only. Never put a production seed here.
METAMASK_PASSWORD=haze-local-qa

# Optional. If set, must be the Anvil test mnemonic (LOCAL_TEST_SEED).
# METAMASK_SEED_PHRASE=test test test test test test test test test test test junk

# Fuji 43113 is the default persist target. Mainnet 43114 is refused.
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_CHAIN_ID=43113
AVALANCHE_NETWORK_NAME=Avalanche Fuji C-Chain
AVALANCHE_CURRENCY_SYMBOL=AVAX

# Commercial host already running. Do not kill a healthy host to change this.
DAPP_URL=http://127.0.0.1:3012

# Operator key belongs in the worktree .env and is read only by dappwright:live.
# Do not put PRIVATE_KEY in this file.
